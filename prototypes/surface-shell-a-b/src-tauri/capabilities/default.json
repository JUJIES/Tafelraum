{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Berechtigungen der lokalen Tafelraum-App",
  "windows": ["main", "room-canvas"],
  "remote": {
    "urls": [
      "http://127.0.0.1:49317/*",
      "http://127.0.0.1:5173/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "allow-desktop-update-overview",
    "allow-request-desktop-update-check",
    "allow-print-desktop-webview",
    "allow-open-external-web-url"
    ,"allow-open-room-canvas"
    ,"allow-close-room-canvas"
    ,"allow-confirm-desktop-persistence"
    ,"allow-set-ui-language"
  ]
}
